# Copy this file to .env and set all three secrets before starting Compose.
# Use a strong SQL Server password (at least 8 characters, with upper/lowercase,
# number, and symbol). Avoid semicolons because it is used in SQL connection strings.
MSSQL_SA_PASSWORD=

# At least 32 random characters for JWT signing.
APP_JWT_SECRET_KEY=

# A separate, strong password for the seeded assessment owner account.
DEMO_SUPERADMIN_PASSWORD=

# Optional host ports. All ports bind to localhost only.
FRONTEND_PORT=8080
SQLSERVER_PORT=14333
REDIS_PORT=16379
